{
  "name": "trello.ia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3030",
    "build": "next build",
    "start": "next start -p 3030",
    "format": "prettier --write .",
    "lint": "eslint src e2e next.config.ts playwright.config.ts jest.config.ts",
    "tree": "tree -L 3 -I 'node_modules|.git|.next|dist|coverage|build|*.map|*.tsbuildinfo|*.d.ts|*.js|*.cjs|*.mjs|*.html|*.json|pnpm-lock.yaml|package-lock.json|public|.turbo|.vscode|.idea|.husky|.github|.swc' -a",
    "clean": "node -e \"for (const p of ['node_modules','.next']) require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "outdated": "pnpm outdated",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:clean": "jest --clearCache",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@radix-ui/react-avatar": "^1.1.6",
    "@radix-ui/react-checkbox": "^1.2.2",
    "@radix-ui/react-dialog": "^1.1.10",
    "@radix-ui/react-label": "^2.1.4",
    "@radix-ui/react-popover": "^1.1.11",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.2.3",
    "@reduxjs/toolkit": "^2.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.487.0",
    "next": "15.5.29",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.55.0",
    "react-redux": "^9.2.0",
    "swr": "^2.3.3",
    "tailwind-merge": "^3.2.0",
    "tailwind-variants": "^1.0.0",
    "tw-animate-css": "^1.2.5",
    "yup": "^1.6.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@next/eslint-plugin-next": "15.5.29",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.30",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "eslint": "^9.25.0",
    "eslint-config-next": "15.5.29",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.4",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x"
  }
}
